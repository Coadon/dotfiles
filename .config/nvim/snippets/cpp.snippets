snippet _KICKSTART_M
	$1

	#include <bits/stdc++.h>
	using namespace std;

	template <typename T> using vt = vector<T>;

	typedef unsigned long long int ull;
	typedef unsigned int u32;
	typedef long long int ll;
	typedef long double lld;
	typedef pair<ll,ll> pll;
	typedef vector<ll> vi;

	#define LOG(a) cerr << "[DEBUG]["<<__LINE__<<"]: " << (a) << endl
	#define INF numeric_limits<ll>::max()
	#define all(x) (x).begin(), (x).end()
	#define popf(x) (x).erase((x).begin())
	#define sz(x) ((int)(x).size())
	#define setp(x) setprecision(x)
	#define mp(x,y) make_pair(x,y)
	#define pb push_back
	#define ppb pop_back
	#define ff first
	#define ss second
	#define nl '\n'

	void solve() {
		$2
	}

	int main(void) {
		ios::sync_with_stdio(0);
		cin.tie(0);

		int tc = 1;
		cin >> tc;
		while (tc--) {
			solve();
		}
	}

snippet _KICKSTART_L
	$1

	// clang-format off
	#include <bits/stdc++.h>
	using namespace std;

	/*
	#include <ext/pb_ds/assoc_container.hpp>
	#include <ext/pb_ds/tree_policy.hpp>
	using namespace __gnu_pbds;
	template <typename T>
	using indexed_set = tree<T,null_type,less<int>,rb_tree_tag,tree_order_statistics_node_update>;
	*/

	template <typename T> using mpque = priority_queue<T, vector<T>, greater<T>>;
	template <typename T> using pque = priority_queue<T>;
	template <typename T, size_t N> using ar = array<T, N>;
	template <typename T> using vt = vector<T>;

	#define FastIO ios_base::sync_with_stdio(false); cin.tie(NULL); cout.tie(NULL)

	typedef unsigned long long int ull;
	typedef unsigned int u32;
	typedef long long int ll;
	typedef long double lld;
	typedef pair<ll,ll> pll;
	typedef vector<ll> vi;

	#define LOG(a) cerr << "[DEBUG]["<<__LINE__<<"]: " << (a) << endl
	#define INF numeric_limits<ll>::max()
	#define setp(x)     setprecision(x)
	#define all(x)      (x).begin(), (x).end()
	#define rall(x)     (x).rbegin(), (x).rend()
	#define popf(x)     (x).erase((x).begin())
	#define sz(x)       ((int)(x).size())
	#define mp(x, y)    make_pair(x, y)
	#define pb          push_back
	#define ppb         pop_back
	#define ff          first
	#define ss          second
	#define nl '\n'

	mt19937 mt_rng(chrono::steady_clock::now().time_since_epoch().count());
	ll randint(ll a, ll b) { return uniform_int_distribution<ll>(a, b)(mt_rng); }
	ll gcd(ll a, ll b) {if (b > a) {return gcd(b, a);} if (b == 0) {return a;} return gcd(b, a % b);}
	ll lcm(ll a, ll b) { return (a / gcd(a, b)) * b; }
	ll modpow(ll a, ll b, ll mod) {ll res = 1; while (b > 0) {if (b & 1)res = (res * a) % mod; a = (a * a) % mod; b = b >> 1;} return res;}
	ll mminvprime(ll a, ll b) {return modpow(a, b - 2, b);}
	ll modadd(ll a, ll b, ll m) {a = a % m; b = b % m; return (((a + b) % m) + m) % m;}
	ll modmul(ll a, ll b, ll m) {a = a % m; b = b % m; return (((a * b) % m) + m) % m;}
	ll modsub(ll a, ll b, ll m) {a = a % m; b = b % m; return (((a - b) % m) + m) % m;}
	ll moddiv(ll a, ll b, ll m) {a = a % m; b = b % m; return (modmul(a, mminvprime(b, m), m) + m) % m;}
	bool isprime(ll n) { if(n < 2) return false; for(ll k = 2; k * k <= n; k++) if(n % k == 0) return false; return true; }
	// clang-format on

	void solve(const u32& TC) {
		$2
	}

	int main(void) {
		FastIO;

		int t = 1;
		cin >> tc;
		for (u32 i = 1; i <= tc; i++) {
			solve(i);
		}
	}

